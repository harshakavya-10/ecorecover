# Copy to .env (or export in your shell). Placeholders only - never commit real values.
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
# "demo" (default, clearly labelled, not a real prediction) or "rekognition" (real model, needs AWS creds)
CLASSIFIER=demo
AWS_REGION=ap-south-1
# Optional: store uploads in S3 instead of ./uploads
S3_BUCKET=
# Optional: override prioritisation weights, e.g. {"waitPerDay":3}
PRIORITY_WEIGHTS=
